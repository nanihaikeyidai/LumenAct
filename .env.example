# LumenAct 语音对话环境变量示例。server.py 不会自动读取 .env 文件：请在启动前 export（macOS/Linux）或 set（Windows）。
# 服务端密钥只会发往同名 *_ENDPOINT 配置的地址，不会返回给网页。

# LLM（OpenAI 兼容 /chat/completions）
LUMENACT_LLM_ENDPOINT=https://example.com/v1/chat/completions
LUMENACT_LLM_MODEL=your-model
LUMENACT_LLM_KEY=

# TTS 默认后端：runninghub / indextts-local / openai / browser / off
LUMENACT_TTS_BACKEND=runninghub
# IndexTTS 2.5 · RunningHub 工作流（自动取其中第一段 32 位十六进制作为 apiKey）
RUNNINGHUB_API_KEY=
LUMENACT_INDEXTTS_REF=/path/to/your-voice.wav
# 已上传过的参考音色可直接填 fileName，跳过上传
LUMENACT_RH_REF_FILENAME=
# 自建 IndexTTS HTTP（见 tools/indextts_http_server.py）
LUMENACT_INDEXTTS_ENDPOINT=
# OpenAI 兼容云端 TTS
LUMENACT_TTS_ENDPOINT=
LUMENACT_TTS_MODEL=
LUMENACT_TTS_VOICE=
LUMENACT_TTS_KEY=

# ASR 默认后端：browser / r2t2 / openai / local
LUMENACT_ASR_BACKEND=browser
LUMENACT_ASR_ENDPOINT=
LUMENACT_ASR_MODEL=
LUMENACT_ASR_KEY=
LUMENACT_ASR_LANGUAGE=zh
